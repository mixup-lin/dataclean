# ============================================================
# LLM 配置示例：复制为项目根目录的 .env 即可生效（无需 python-dotenv）
#
# 优先级：显式导出的系统环境变量 > 本文件；本文件修改后无需重启进程。
# HTTP 优先使用 requests，未安装时自动退回标准库 urllib，在线功能不受影响。
# 兼容别名：OPENAI_API_KEY / OPENAI_BASE_URL（仅当 LLM_* 未设置时生效）。
# 排查命令：python etl_pipeline.py llm-check（输出绝不包含 API Key 的值）。
#
# 无 LLM_API_KEY 时：自然语言规则生成与文档抽取不可用（会明确报错，
# 不再降级到关键词 Mock 模板）；仍可用 CLI --rule-file 或工作台
# 「显式规则 JSON」离线执行已有规则，核心 ETL 管道不依赖 LLM。
# ============================================================

# OpenAI 兼容端点（不含 /chat/completions，程序会自动拼接）
LLM_BASE_URL=https://api.openai.com/v1

# API Key。留空 = 自然语言规则生成与文档抽取不可用；
# 离线执行请用 --rule-file / 工作台显式规则 JSON（无需 Key）。
LLM_API_KEY=

# 文本模型（自然语言 -> 规则、文档文本抽取）
LLM_MODEL=gpt-4o-mini

# 视觉模型（图片 / 扫描件 OCR 式抽取）；留空则复用 LLM_MODEL
LLM_VISION_MODEL=

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 失败重试次数（仅网络错误 / 5xx 重试，4xx 不重试）
LLM_MAX_RETRIES=2

# 可选：provider 选择，仅支持 openai / openai-compat；留空自动判断。
# 已废弃的 mock 会明确报错（离线请改用 --rule-file / 显式规则 JSON）。
LLM_PROVIDER=
